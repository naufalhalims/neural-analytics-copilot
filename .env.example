# Neural Analytics Copilot - Environment Configuration Example

# Upstream LLM / AI Gateway Configuration
# -------------------------------------------------------------
# Sistem kompatibel dengan standard OpenAI API endpoint (OpenAI, Groq, OpenRouter, vLLM, Ollama, 9router).
# Jika dikosongkan/offline, sistem tetap berfungsi penuh dengan deterministik rule-based & statistical fallback.

# Opsi A: OpenAI Langsung
# ROUTER_URL=https://api.openai.com/v1/chat/completions
# ROUTER_MODEL=gpt-4o-mini
# ROUTER_API_KEY=sk-...

# Opsi B: OpenRouter / Groq Cloud
# ROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# ROUTER_MODEL=google/gemini-2.0-flash-001
# ROUTER_API_KEY=sk-or-v1-...

# Opsi C: Local Gateway / 9router (Default Local Dev)
ROUTER_URL=http://127.0.0.1:20128/v1/chat/completions
ROUTER_MODEL=ag/gemini-3.8-flash-low
ROUTER_API_KEY=

# TypeSafe Jev Engine (Opsional: Zero-Latency Speculative Intent Router <10ms)
TYPESAFE_API_KEY=
TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest

# Application Server
PORT=8508
HOST=127.0.0.1
DEBUG=false
